---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getPersonSchema, getBreadcrumbSchema } from '../../utils/structured-data';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

interface Artist {
  slug: string;
  name: string;
  photo: string;
  bio: string;
  specialties: string[];
  instagram: string;
}

interface GalleryItem {
  image: string;
  alt: string;
}

export function getStaticPaths() {
  const artistsDir = path.join(process.cwd(), 'src/content/artists');
  const files = fs.readdirSync(artistsDir).filter((f: string) => f.endsWith('.mdoc'));

  return files.map((file: string) => {
    const raw = fs.readFileSync(path.join(artistsDir, file), 'utf-8');
    const match = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
    if (!match) return null;

    const fm = match[1];
    const bio = match[2].trim();

    const nameMatch = fm.match(/^name:\s*(.+)$/m);
    const name = nameMatch ? nameMatch[1].trim() : '';

    const photoMatch = fm.match(/^photo:\s*(.+)$/m);
    const photo = photoMatch ? photoMatch[1].trim().replace(/^['"]|['"]$/g, '') : '';

    const instagramMatch = fm.match(/^instagram:\s*(.+)$/m);
    const instagram = instagramMatch ? instagramMatch[1].trim().replace(/^['"]|['"]$/g, '') : '';

    const specialties: string[] = [];
    const specSection = fm.match(/^specialties:\s*\n((?:\s+-\s+.+\n?)*)/m);
    if (specSection) {
      const items = specSection[1].matchAll(/^\s+-\s+(.+)$/gm);
      for (const item of items) {
        specialties.push(item[1].trim());
      }
    }

    const slug = file.replace('.mdoc', '');

    return {
      params: { slug },
      props: {
        artist: { slug, name, photo, bio, specialties, instagram },
      },
    };
  }).filter(Boolean);
}

const { artist } = Astro.props as { artist: Artist };

// Load gallery items for this artist (YAML files)
const galleryDir = path.join(process.cwd(), 'src/content/gallery');
const galleryItems: GalleryItem[] = [];

if (fs.existsSync(galleryDir)) {
  const galleryFiles = fs.readdirSync(galleryDir).filter((f: string) => f.endsWith('.yaml') || f.endsWith('.yml'));

  for (const file of galleryFiles) {
    const raw = fs.readFileSync(path.join(galleryDir, file), 'utf-8');
    const data = yaml.load(raw) as Record<string, any>;

    if (data.artist === artist.slug) {
      if (data.image) {
        galleryItems.push({
          image: data.image,
          alt: data.title || artist.name,
        });
      }
    }
  }
}

const pageTitle = `${artist.name} - Tatuador en Neu Studio, Sevilla`;
const pageDescription = `${artist.name}, artista en Neu Studio. Especialista en ${artist.specialties.join(', ')}. Reserva tu cita.`;

const structuredData = [
  getPersonSchema(artist),
  getBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Artistas', url: '/artistas' },
    { name: artist.name, url: `/artistas/${artist.slug}` },
  ]),
];
---

<Base
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <main class="pt-24 pb-16 px-6 md:px-12 max-w-7xl mx-auto">
    <!-- Artist header: two columns -->
    <div class="flex flex-col md:flex-row gap-8 md:gap-0">
      <!-- Left column: photo -->
      <div class="md:w-1/3">
        {artist.photo ? (
          <img
            src={artist.photo}
            alt={artist.name}
            class="w-full aspect-[3/4] object-cover"
            width="400"
            height="533"
            transition:name={'artist-' + artist.slug}
          />
        ) : (
          <div
            class="w-full aspect-[3/4] bg-brand-gray/30"
            transition:name={'artist-' + artist.slug}
          />
        )}
      </div>

      <!-- Right column: info -->
      <div class="md:w-2/3 md:pl-12">
        <h1 class="font-display text-[clamp(2rem,4vw,3rem)] tracking-tight-display">
          {artist.name}
        </h1>

        {artist.specialties.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {artist.specialties.map((spec) => (
              <span class="font-accent text-[10px] tracking-wide-label uppercase border border-brand-border px-3 py-1">
                {spec}
              </span>
            ))}
          </div>
        )}

        {artist.bio && (
          <p class="font-body text-sm text-brand-gray mt-6 whitespace-pre-line">
            {artist.bio}
          </p>
        )}

        {artist.instagram && (
          <a
            href={artist.instagram.startsWith('http') ? artist.instagram : 'https://instagram.com/' + artist.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block font-accent text-xs tracking-wide-label text-brand-blue mt-4"
          >
            @{artist.instagram.replace(/^https?:\/\/(www\.)?instagram\.com\//, '').replace(/\/$/, '') || artist.instagram}
          </a>
        )}

        <a
          href="/contacto"
          class="inline-block bg-brand-blue text-white font-body text-sm px-8 py-4 mt-8 hover:bg-brand-blue-hover transition-colors duration-300"
        >
          Contactar
        </a>
      </div>
    </div>

    <!-- Gallery section -->
    <section class="mt-24">
      <span class="block font-accent text-xs tracking-wider-label uppercase text-brand-gray mb-4">
        TRABAJOS
      </span>
      <h2 class="font-display text-[clamp(1.5rem,3vw,2.5rem)] tracking-tight-display mb-12">
        Portfolio
      </h2>

      {galleryItems.length > 0 ? (
        <div class="grid grid-cols-2 md:grid-cols-3 gap-1">
          {galleryItems.map((item) => (
            <div class="aspect-square overflow-hidden">
              <img
                src={item.image}
                alt={item.alt}
                loading="lazy"
                width="400"
                height="400"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
          ))}
        </div>
      ) : (
        <p class="font-body text-sm text-brand-gray">
          Proximamente se publicaran trabajos de {artist.name}.
        </p>
      )}
    </section>
  </main>
</Base>
