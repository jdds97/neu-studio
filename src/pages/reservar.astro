---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { PAGE_SEO } from '../utils/seo-config';
import { getBreadcrumbSchema } from '../utils/structured-data';
import { getSingleton } from '../utils/content';

const bookingPage = getSingleton<Record<string, string>>('booking-page');

const breadcrumb = getBreadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Reservar', url: '/reservar' },
]);
---

<Base
  title={PAGE_SEO.reservar.title}
  description={PAGE_SEO.reservar.description}
  structuredData={breadcrumb}
>
  <main class="pt-24 pb-16 px-6 md:px-12 max-w-7xl mx-auto">
    <p class="font-accent text-xs tracking-wider-label uppercase text-brand-gray mb-4">{bookingPage.label || 'Reservas'}</p>
    <h1 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display mb-4">
      {bookingPage.title || 'Reservar cita'}
    </h1>
    <p class="font-body text-sm text-brand-gray mb-12 max-w-lg">
      {bookingPage.description || 'Elige artista, tipo de sesión y horario. Las sesiones varían entre 2 y 8 horas según el trabajo.'}
    </p>

    <!-- Cal.com inline embed placeholder -->
    <div id="cal-embed" class="min-h-[600px] border border-brand-border"></div>
  </main>
</Base>

<script is:inline>
  // Cal.com embed - replace CAL_LINK with actual link when available
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement('script')).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === 'string') {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ['initNamespace', namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', { origin: 'https://app.cal.com' });
  Cal('inline', {
    elementOrSelector: '#cal-embed',
    calLink: 'neu-studio/tattoo',
    layout: 'month_view',
    config: { theme: 'light' },
  });
  Cal('ui', {
    theme: 'light',
    styles: { branding: { brandColor: '#2A2AEE' } },
  });
</script>
