---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceMarquee from '../components/ServiceMarquee.astro';
import Services from '../components/Services.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import ArtistCard from '../components/ArtistCard.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { PAGE_SEO } from '../utils/seo-config';
import { getWebSiteSchema, getFAQSchema } from '../utils/structured-data';
import { getSingleton } from '../utils/content';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

const home = getSingleton<Record<string, string>>('home');

// --- Featured Gallery ---
const galleryDir = path.join(process.cwd(), 'src/content/gallery');
interface GalleryItem {
  slug: string;
  title: string;
  image: string;
  artist: string;
  style: string;
  featured: boolean;
}
let featuredItems: GalleryItem[] = [];

try {
  const galleryFiles = fs.readdirSync(galleryDir).filter((f: string) => f.endsWith('.yaml') || f.endsWith('.yml'));
  const allItems: GalleryItem[] = galleryFiles.map((file: string) => {
    const raw = fs.readFileSync(path.join(galleryDir, file), 'utf-8');
    const data = yaml.load(raw) as Record<string, any>;
    const slug = file.replace(/\.ya?ml$/, '');
    return {
      slug,
      title: data.title || slug,
      image: data.image || '',
      artist: data.artist || '',
      style: data.style || '',
      featured: data.featured === true,
    };
  });
  featuredItems = allItems.filter((item) => item.featured).slice(0, 10);
} catch {
  // Gallery directory empty or unreadable — featuredItems stays empty
}

// --- Artists ---
interface Artist {
  slug: string;
  name: string;
  photo: string;
  specialties: string[];
  order: number;
}

const artistsDir = path.join(process.cwd(), 'src/content/artists');
const artistFiles = fs.readdirSync(artistsDir).filter((f: string) => f.endsWith('.mdoc'));

const artists: Artist[] = artistFiles.map((file: string) => {
  const raw = fs.readFileSync(path.join(artistsDir, file), 'utf-8');
  const match = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
  if (!match) return null;

  const slug = file.replace('.mdoc', '');
  const frontmatter = match[1];

  // Parse name
  const nameMatch = frontmatter.match(/^name:\s*(.+)$/m);
  const name = nameMatch ? nameMatch[1].trim() : slug;

  // Parse photo
  const photoMatch = frontmatter.match(/^photo:\s*(.+)$/m);
  const photo = photoMatch ? photoMatch[1].trim().replace(/^['"]|['"]$/g, '') : '';

  // Parse order
  const orderMatch = frontmatter.match(/^order:\s*(\d+)$/m);
  const order = orderMatch ? parseInt(orderMatch[1], 10) : 0;

  // Parse specialties (YAML array)
  const specialties: string[] = [];
  const specBlock = frontmatter.match(/^specialties:\s*\n((?:\s+-\s+.+\n?)*)/m);
  if (specBlock) {
    const lines = specBlock[1].split('\n');
    lines.forEach((line: string) => {
      const itemMatch = line.match(/^\s+-\s+(.+)/);
      if (itemMatch) specialties.push(itemMatch[1].trim());
    });
  }

  return { slug, name, photo, specialties, order };
}).filter(Boolean) as Artist[];

artists.sort((a, b) => a.order - b.order);

// --- FAQ for structured data ---
const faqDir = path.join(process.cwd(), 'src/content/faq');
let faqItems: { question: string; answer: string }[] = [];
try {
  const faqFiles = fs.readdirSync(faqDir).filter((f: string) => f.endsWith('.mdoc'));
  faqItems = faqFiles.map((file: string) => {
    const raw = fs.readFileSync(path.join(faqDir, file), 'utf-8');
    const match = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
    if (!match) return null;
    const fm: Record<string, string> = {};
    match[1].split('\n').forEach((line: string) => {
      const idx = line.indexOf(':');
      if (idx > 0) {
        fm[line.slice(0, idx).trim()] = line.slice(idx + 1).trim();
      }
    });
    return { question: fm.question || '', answer: match[2].trim() };
  }).filter(Boolean) as { question: string; answer: string }[];
} catch {
  // FAQ directory empty
}

const structuredData = [
  getWebSiteSchema(),
  ...(faqItems.length > 0 ? [getFAQSchema(faqItems)] : []),
];
---

<Base
  title={PAGE_SEO.home.title}
  description={PAGE_SEO.home.description}
  structuredData={structuredData}
>
  <main>
    <!-- 1. Hero -->
    <Hero />

    <!-- 1.5 Service Marquee -->
    <ServiceMarquee />

    <!-- 2. Services -->
    <Services />

    <!-- 3. Featured Gallery -->
    {featuredItems.length > 0 ? (
      <section id="galeria" class="py-24 px-6 md:px-12 max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-16 gap-6">
          <div>
            <span class="block font-accent text-xs tracking-wider-label uppercase text-brand-gray mb-4">
              {home.galleryLabel || 'Galería'}
            </span>
            <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display">
              {home.galleryTitle || 'Trabajos destacados'}
            </h2>
          </div>
          <a
            href="/galeria"
            class="font-accent text-xs tracking-wide-label uppercase text-brand-blue hover:text-brand-blue-hover transition-colors"
          >
            {home.galleryLink || 'Ver toda la galería'} &rarr;
          </a>
        </div>
        <GalleryGrid items={featuredItems} />

        <!-- CTA -->
        <div class="mt-12 text-center">
          <a
            href="/contacto"
            class="inline-block bg-brand-blue text-white font-body text-sm font-medium px-8 py-4 hover:bg-brand-blue-hover transition-colors"
          >
            Contactar
          </a>
        </div>
      </section>
    ) : (
      <section id="galeria" class="py-24 px-6 md:px-12 max-w-7xl mx-auto">
        <span class="block font-accent text-xs tracking-wider-label uppercase text-brand-gray mb-4">
          {home.galleryLabel || 'Galería'}
        </span>
        <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display mb-16">
          {home.galleryTitle || 'Trabajos destacados'}
        </h2>
        <div class="text-center py-12">
          <p class="font-accent text-sm tracking-wide-label uppercase text-brand-gray">
            Próximamente
          </p>
        </div>
      </section>
    )}

    <!-- 4. Artists Preview -->
    <section id="artistas" class="py-24 bg-[#c8c8c8]/10">
      <div class="px-6 md:px-12 max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-16 gap-6">
        <div>
          <span class="block font-accent text-xs tracking-wider-label uppercase text-brand-gray mb-4">
            {home.artistsLabel || 'Artistas'}
          </span>
          <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display">
            {home.artistsTitle || 'Nuestro equipo'}
          </h2>
        </div>
        <a
          href="/artistas"
          class="font-accent text-xs tracking-wide-label uppercase text-brand-blue hover:text-brand-blue-hover transition-colors"
        >
          {home.artistsLink || 'Ver todos'} &rarr;
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {artists.map((artist) => (
          <ArtistCard
            name={artist.name}
            slug={artist.slug}
            photo={artist.photo}
            specialties={artist.specialties}
          />
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <a
          href="/contacto"
          class="inline-block bg-brand-blue text-white font-body text-sm font-medium px-8 py-4 hover:bg-brand-blue-hover transition-colors"
        >
          Contactar
        </a>
      </div>
      </div>
    </section>

    <!-- 5. Process -->
    <Process />

    <!-- 6. Testimonials -->
    <Testimonials />

    <!-- 7. FAQ -->
    <FAQ />

    <!-- 8. CTA Section -->
    <CTASection />
  </main>
</Base>
