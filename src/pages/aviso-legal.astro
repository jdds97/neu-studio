---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { PAGE_SEO } from '../utils/seo-config';
import Markdoc from '@markdoc/markdoc';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const legal = await reader.singletons.avisoLegal.read();

let htmlContent = '<p>Contenido no disponible. Edítalo desde Keystatic.</p>';
if (legal?.content) {
  const doc = await legal.content();
  const rendered = Markdoc.renderers.html(Markdoc.transform(doc.node));
  htmlContent = rendered;
}
---

<Base
  title={PAGE_SEO.avisoLegal.title}
  description={PAGE_SEO.avisoLegal.description}
  noindex={true}
>
  <main class="pt-24 pb-16 px-6 md:px-12 max-w-3xl mx-auto">
    <h1 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display mb-12">
      Aviso Legal
    </h1>
    <div class="prose prose-sm font-body text-brand-gray max-w-none" set:html={htmlContent} />
  </main>
</Base>
