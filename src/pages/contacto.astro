---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { PAGE_SEO, BUSINESS_INFO } from '../utils/seo-config';
import { getBreadcrumbSchema } from '../utils/structured-data';

const breadcrumb = getBreadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto' },
]);

const year = new Date().getFullYear();
---

<Base
  title={PAGE_SEO.contacto.title}
  description={PAGE_SEO.contacto.description}
  structuredData={breadcrumb}
  hideFooter={true}
>
  <main class="relative overflow-hidden">
    <!-- Mapa de Dos Hermanas como fondo decorativo (cubre todo: contacto + footer) -->
    <div
      class="absolute inset-0 opacity-[0.05] pointer-events-none"
      style="background-image: url('/images/branding/bg-map.webp'); background-size: cover; background-position: center;"
      aria-hidden="true"
    ></div>

    <!-- Contacto -->
    <section class="relative pt-24 pb-16 px-6 md:px-12 max-w-7xl mx-auto">
      <p class="font-accent text-xs tracking-wider-label uppercase text-brand-gray mb-4">CONTACTO</p>
      <h1 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display mb-12">
        Hablemos
      </h1>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 mb-16">
        <!-- Form -->
        <div>
          <form id="contact-form" class="space-y-6">
            <div>
              <label for="name" class="block font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-2">
                Nombre *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full border border-brand-border bg-transparent font-body text-sm px-4 py-3 focus:border-brand-blue focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-2">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full border border-brand-border bg-transparent font-body text-sm px-4 py-3 focus:border-brand-blue focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="phone" class="block font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-2">
                Telefono
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full border border-brand-border bg-transparent font-body text-sm px-4 py-3 focus:border-brand-blue focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-2">
                Mensaje *
              </label>
              <textarea
                id="message"
                name="message"
                required
                class="w-full border border-brand-border bg-transparent font-body text-sm px-4 py-3 min-h-[150px] focus:border-brand-blue focus:outline-none transition-colors resize-vertical"
              ></textarea>
            </div>

            <div id="success-msg" class="hidden font-body text-sm text-green-600">
              Mensaje enviado. Te contactaremos pronto.
            </div>

            <div id="error-msg" class="hidden font-body text-sm text-red-600">
              Error al enviar. Intentalo de nuevo o contactanos por WhatsApp.
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="bg-brand-blue text-white font-body text-sm font-medium px-8 py-4 w-full hover:bg-brand-blue-hover transition-colors disabled:opacity-50"
            >
              Enviar mensaje
            </button>
          </form>
        </div>

        <!-- Info -->
        <div class="space-y-6">
          <div>
            <p class="font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-1">DIRECCION</p>
            <p class="font-body text-sm text-brand-dark">{BUSINESS_INFO.address.street}</p>
            <p class="font-body text-sm text-brand-dark">{BUSINESS_INFO.address.postalCode} {BUSINESS_INFO.address.locality}, {BUSINESS_INFO.address.region}</p>
          </div>

          <div>
            <p class="font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-1">TELEFONO</p>
            <a href={`tel:${BUSINESS_INFO.phone}`} class="font-body text-sm text-brand-dark hover:text-brand-blue transition-colors">
              {BUSINESS_INFO.phoneDisplay}
            </a>
          </div>

          <div>
            <p class="font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-1">WHATSAPP</p>
            <a href={`https://wa.me/${BUSINESS_INFO.whatsapp}`} target="_blank" rel="noopener noreferrer" class="font-body text-sm text-brand-dark hover:text-brand-blue transition-colors">
              {BUSINESS_INFO.phoneDisplay}
            </a>
          </div>

          <div>
            <p class="font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-1">EMAIL</p>
            <a href={`mailto:${BUSINESS_INFO.email}`} class="font-body text-sm text-brand-dark hover:text-brand-blue transition-colors">
              {BUSINESS_INFO.email}
            </a>
          </div>

          <div>
            <p class="font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-1">HORARIO</p>
            <p class="font-body text-sm text-brand-dark">{BUSINESS_INFO.schedule.display}</p>
          </div>

          <div class="pt-4">
            <p class="font-accent text-xs tracking-wide-label uppercase text-brand-gray mb-3">REDES SOCIALES</p>
            <div class="flex gap-6">
              <a href={BUSINESS_INFO.instagram} target="_blank" rel="noopener noreferrer" class="font-body text-sm text-brand-blue hover:underline">Instagram</a>
              <a href={BUSINESS_INFO.tiktok} target="_blank" rel="noopener noreferrer" class="font-body text-sm text-brand-blue hover:underline">TikTok</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Google Maps -->
      <div class="w-full">
        <iframe
          src={BUSINESS_INFO.googleMapsEmbed}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicacion de Neu Studio en Google Maps"
          class="w-full h-[400px]"
        ></iframe>
      </div>
    </section>

    <!-- Footer integrado -->
    <footer class="relative px-6 md:px-12 pt-12 pb-8 border-t border-brand-border/30 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-8">
        <div>
          <a href="/" class="inline-block">
            <img
              src="/images/logo-nav.png"
              alt="Neu Studio"
              class="h-[18px] w-auto"
              width="480"
              height="37"
              loading="lazy"
            />
          </a>
          <p class="font-body text-sm text-brand-gray mt-3">
            {BUSINESS_INFO.address.street}<br />
            {BUSINESS_INFO.address.postalCode} {BUSINESS_INFO.address.locality}, {BUSINESS_INFO.address.region}
          </p>
          <a href={`tel:${BUSINESS_INFO.phone}`} class="font-body text-sm text-brand-gray mt-2 block hover:text-brand-dark transition-colors">
            {BUSINESS_INFO.phoneDisplay}
          </a>
          <a href={`mailto:${BUSINESS_INFO.email}`} class="font-body text-sm text-brand-gray mt-1 block hover:text-brand-dark transition-colors">
            {BUSINESS_INFO.email}
          </a>
          <a href={BUSINESS_INFO.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="font-accent text-xs tracking-wide-label uppercase text-brand-blue mt-4 block hover:underline transition-colors">
            Ver en Google Maps
          </a>
        </div>

        <nav>
          <ul class="flex flex-col gap-3">
            <li><a href="/artistas" class="font-body text-sm text-brand-gray hover:text-brand-dark transition-colors">Artistas</a></li>
            <li><a href="/galeria" class="font-body text-sm text-brand-gray hover:text-brand-dark transition-colors">Galeria</a></li>
            <li><a href="/contacto" class="font-body text-sm text-brand-gray hover:text-brand-dark transition-colors">Contacto</a></li>
          </ul>
        </nav>

        <div>
          <ul class="flex flex-col gap-3">
            <li><a href={BUSINESS_INFO.instagram} target="_blank" rel="noopener noreferrer" class="font-accent text-xs tracking-wide-label uppercase text-brand-gray hover:text-brand-blue transition-colors">Instagram</a></li>
            <li><a href={BUSINESS_INFO.tiktok} target="_blank" rel="noopener noreferrer" class="font-accent text-xs tracking-wide-label uppercase text-brand-gray hover:text-brand-blue transition-colors">TikTok</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-brand-border/30 pt-6 flex flex-col sm:flex-row justify-between gap-4">
        <p class="font-body text-xs text-brand-gray">&copy; {year} Neu Studio</p>
        <div class="flex gap-4 font-body text-xs text-brand-gray">
          <a href="/aviso-legal" class="hover:text-brand-dark transition-colors">Aviso legal</a>
          <span>|</span>
          <a href="/privacidad" class="hover:text-brand-dark transition-colors">Privacidad</a>
          <span>|</span>
          <a href="/cookies" class="hover:text-brand-dark transition-colors">Cookies</a>
        </div>
      </div>
    </footer>
  </main>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const successMsg = document.getElementById('success-msg');
  const errorMsg = document.getElementById('error-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';

    const formData = new FormData(form);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: formData,
      });

      if (res.ok) {
        form.reset();
        successMsg?.classList.remove('hidden');
        errorMsg?.classList.add('hidden');
      } else {
        throw new Error('Error');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
      successMsg?.classList.add('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar mensaje';
    }
  });
</script>
