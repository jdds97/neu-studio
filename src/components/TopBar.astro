    <a
      href="tel:+34695149305"
      class="hidden sm:flex items-center gap-1.5 group"
    >
      <svg class="w-3 h-3 text-white/40 group-hover:text-brand-blue transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
