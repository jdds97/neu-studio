        href="https://tiktok.com/@neu.neu.eu"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 group"
      >
        <svg class="w-3 h-3 text-white/40 group-hover:text-brand-blue transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
