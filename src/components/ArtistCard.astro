---
interface Props {
  name: string;
  slug: string;
  photo: string;
  specialties: string[];
}

const { name, slug, photo, specialties } = Astro.props;
---

<a href={'/artistas/' + slug} class="group block relative aspect-[3/4] overflow-hidden">
  {photo ? (
    <img
      src={photo}
      alt={name}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      decoding="async"
      width="600"
      height="800"
      transition:name={'artist-' + slug}
    />
  ) : (
    <div
      class="w-full h-full bg-brand-gray/30 transition-transform duration-500 group-hover:scale-105"
      transition:name={'artist-' + slug}
    />
  )}
  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent pt-16 pb-6 px-6">
    <span class="block font-display text-lg text-white">{name}</span>
    {specialties.length > 0 && (
      <span class="block font-accent text-[10px] tracking-wide-label uppercase text-white/70 mt-1">
        {specialties.join(' / ')}
      </span>
    )}
  </div>
</a>
