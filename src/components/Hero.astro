---
import { getSingleton } from '../utils/content';

const home = getSingleton<Record<string, string>>('home');
const site = getSingleton<Record<string, string>>('site');

const title = home.heroTitle || 'NEU STUDIO';
const subtitle = home.heroSubtitle || 'Estudio de tatuaje en Dos Hermanas, Sevilla';
const heroImage = home.heroImage || '/images/logo-hero.png';
const ctaPrimary = home.heroCtaPrimary || 'Reservar cita';
const ctaPrimaryUrl = home.heroCtaPrimaryUrl || '/contacto';
const ctaSecondary = home.heroCtaSecondary || 'Ver galería';
const ctaSecondaryUrl = home.heroCtaSecondaryUrl || '/galeria';
const googleRating = site.googleRating || '5.0';
const instagramHandle = site.instagramHandle || '@neu.studio_';
const instagramUrl = site.instagram || 'https://instagram.com/neu.studio_';
---

<section class="relative h-screen flex flex-col items-center justify-center overflow-hidden bg-[#c8c8c8]">
  <!-- CSS glow: top-left blue -->
  <div
    class="absolute -top-32 -left-32 w-[500px] h-[500px] md:w-[700px] md:h-[700px] rounded-full opacity-15 pointer-events-none hero-glow"
    style="background: radial-gradient(circle, rgba(42,42,238,0.6) 0%, rgba(42,42,238,0.15) 30%, transparent 65%);"
    aria-hidden="true"
  ></div>

  <!-- CSS glow: bottom-right blue -->
  <div
    class="absolute -bottom-40 -right-40 w-[450px] h-[450px] md:w-[650px] md:h-[650px] rounded-full opacity-12 pointer-events-none hero-glow"
    style="background: radial-gradient(circle, rgba(42,42,238,0.5) 0%, rgba(42,42,238,0.1) 35%, transparent 65%); animation-delay: -3s; animation-duration: 10s;"
    aria-hidden="true"
  ></div>

  <!-- CSS glow: center subtle -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] md:w-[900px] md:h-[900px] rounded-full opacity-8 pointer-events-none"
    style="background: radial-gradient(circle, rgba(42,42,238,0.2) 0%, transparent 50%);"
    aria-hidden="true"
  ></div>

  <!-- Grain texture overlay -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.03] mix-blend-overlay"
    style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E&quot;);"
    aria-hidden="true"
  ></div>

  <!-- Soft vignette -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.08) 100%);"
    aria-hidden="true"
  ></div>

  <!-- Main content -->
  <div class="relative z-10 flex flex-col items-center text-center px-6">
    <!-- Logo NEU vertical with blue neon glow -->
    <picture>
      <source
        srcset={heroImage.replace(/\.png$/, '.webp')}
        type="image/webp"
      />
      <img
        src={heroImage}
        alt={`${title} - ${subtitle}`}
        class="h-[220px] md:h-[320px] lg:h-[400px] w-auto pointer-events-none hero-logo"
        fetchpriority="high"
        decoding="async"
        width="800"
        height="1366"
      />
    </picture>

    <!-- Title (screen reader) -->
    <h1 class="sr-only">{title}</h1>

    <!-- Tagline -->
    <p class="font-accent text-[0.65rem] md:text-xs tracking-[0.3em] uppercase text-white mt-8">
      {subtitle}
    </p>

    <!-- Divider line -->
    <div class="w-10 h-[1px] bg-white/40 mt-6" aria-hidden="true"></div>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row gap-4 mt-8">
      <a
        href={ctaPrimaryUrl}
        class="bg-brand-blue text-white font-accent text-xs tracking-[0.2em] uppercase font-medium px-10 py-4 hover:bg-brand-blue-hover transition-colors duration-300"
      >
        {ctaPrimary}
      </a>
      <a
        href={ctaSecondaryUrl}
        class="border border-white/40 text-white font-accent text-xs tracking-[0.2em] uppercase font-medium px-10 py-4 hover:bg-white/10 hover:border-white/60 transition-colors duration-300"
      >
        {ctaSecondary}
      </a>
    </div>

    <!-- Social proof -->
    <div class="flex items-center gap-6 mt-10">
      <div class="flex items-center gap-2">
        <span class="text-brand-blue text-sm">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="font-accent text-[0.6rem] tracking-[0.15em] uppercase text-white/70">{googleRating} en Google</span>
      </div>
      <span class="w-[1px] h-3 bg-white/30" aria-hidden="true"></span>
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-accent text-[0.6rem] tracking-[0.15em] uppercase text-white/70 hover:text-white transition-colors"
      >
        {instagramHandle}
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 z-10 flex flex-col items-center gap-2" aria-hidden="true">
    <span class="font-accent text-[0.55rem] tracking-[0.3em] uppercase text-white/50">Scroll</span>
    <div class="w-[1px] h-8 bg-white/40 hero-scroll-line"></div>
  </div>
</section>

<style is:global>
  .hero-logo {
    animation: heroLogoIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes heroLogoIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(15px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .hero-glow {
    animation: glowFloat 8s ease-in-out infinite alternate;
  }

  @keyframes glowFloat {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(10px, -8px) scale(1.03); }
  }

  .hero-scroll-line {
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.2; transform: scaleY(1); }
    50% { opacity: 0.5; transform: scaleY(1.3); transform-origin: top; }
  }
</style>
