---
import { getSingleton } from '../utils/content';

const home = getSingleton<Record<string, string>>('home');

const ctaTitle = home.ctaTitle || '¿Listo para tu próximo tatuaje?';
const ctaSubtitle = home.ctaSubtitle || 'Contáctanos y da vida a tu idea con nuestros artistas';
const ctaButton = home.ctaButton || 'Contactar';
const ctaButtonUrl = home.ctaButtonUrl || '/contacto';
---

<section id="cta" class="py-32 bg-[#c8c8c8]/10" data-animate>
  <div class="text-center px-6 md:px-12 max-w-7xl mx-auto">
    <h2 class="font-display text-[clamp(1.5rem,3vw,2.5rem)] tracking-tight-display text-brand-dark">
      {ctaTitle}
    </h2>
    <p class="font-body text-sm text-brand-blue mt-4 max-w-md mx-auto">
      {ctaSubtitle}
    </p>
    <a
      href={ctaButtonUrl}
      class="inline-block bg-brand-blue text-white font-body text-sm font-medium px-10 py-4 mt-8 hover:bg-brand-blue-hover transition-colors"
    >
      {ctaButton}
    </a>
  </div>
</section>
