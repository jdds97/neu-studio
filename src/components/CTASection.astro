<section id="cta" class="relative py-24 bg-brand-blue overflow-hidden" data-animate>
  {/* Grain texture overlay */}
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.02] mix-blend-overlay"
    style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E&quot;);"
    aria-hidden="true"
  ></div>

  <div class="relative text-center px-6 md:px-12">
    <h2 class="font-display text-[clamp(1.5rem,3vw,2.5rem)] tracking-tight-display text-white">
      Listo para tu próximo tatuaje?
    </h2>
    <a
      href="/reservar"
      class="inline-block bg-white text-brand-blue font-body text-sm font-medium px-10 py-4 mt-8 hover:bg-brand-light transition-colors"
    >
      Reservar cita
    </a>
  </div>
</section>
