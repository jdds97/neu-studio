---
import { getSingleton, getCollection } from '../utils/content';

const home = getSingleton<Record<string, string>>('home');
const processLabel = home.processLabel || 'Proceso';
const processTitle = home.processTitle || 'Cómo trabajamos';

interface Step {
  title: string;
  description: string;
  order: number;
}

const rawSteps = getCollection<Step>('process');
const steps = rawSteps
  .sort((a, b) => (a.order || 0) - (b.order || 0))
  .map((s, i) => ({
    number: String(i + 1).padStart(2, '0'),
    title: s.title || '',
    description: s.description || '',
  }));
---

<section id="proceso" class="relative py-24 overflow-hidden" data-animate>
  <!-- Background: Flamenco scene (Sevilla culture) -->
  <img
    src="/images/branding/bg-flamenco.jpg"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
  />
  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-brand-dark/45" aria-hidden="true"></div>

  <div class="relative px-6 md:px-12 max-w-7xl mx-auto">
    <span class="block font-accent text-xs tracking-wider-label uppercase text-white/50 mb-4">
      {processLabel}
    </span>
    <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display text-white mb-16">
      {processTitle}
    </h2>

    {/* Desktop: horizontal layout with connecting line */}
    <div class="hidden md:block relative">
      <div class="absolute top-[2.25rem] left-0 right-0 h-px bg-white/15" aria-hidden="true"></div>
      <div class="grid grid-cols-5 gap-8 relative" data-animate-stagger>
        {steps.map((step) => (
          <div class="relative">
            <span class="block font-display text-4xl text-brand-blue mb-4">
              {step.number}
            </span>
            <h3 class="font-body text-base font-semibold text-white mb-2">
              {step.title}
            </h3>
            <p class="font-body text-sm text-white/60">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    {/* Mobile: vertical layout with connecting line on the left */}
    <div class="md:hidden relative pl-10">
      <div class="absolute top-0 bottom-0 left-3 w-px bg-white/15" aria-hidden="true"></div>
      <div class="flex flex-col gap-10" data-animate-stagger>
        {steps.map((step) => (
          <div class="relative">
            <span class="absolute -left-10 top-0 w-6 h-6 flex items-center justify-center">
              <span class="block w-2 h-2 bg-brand-blue"></span>
            </span>
            <span class="block font-display text-4xl text-brand-blue mb-4">
              {step.number}
            </span>
            <h3 class="font-body text-base font-semibold text-white mb-2">
              {step.title}
            </h3>
            <p class="font-body text-sm text-white/60">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
