---
const steps = [
  {
    number: '01',
    title: 'Contacto',
    description: 'Escríbenos por WhatsApp, teléfono o formulario',
  },
  {
    number: '02',
    title: 'Consulta',
    description: 'Hablamos sobre tu idea y diseño',
  },
  {
    number: '03',
    title: 'Diseño',
    description: 'Preparamos el diseño personalizado',
  },
  {
    number: '04',
    title: 'Sesión',
    description: 'Realizamos el tatuaje con el máximo cuidado',
  },
  {
    number: '05',
    title: 'Aftercare',
    description: 'Te guiamos en el cuidado posterior',
  },
];
---

<section id="proceso" class="py-24 px-6 md:px-12" data-animate>
  <span class="block font-accent text-xs tracking-wider-label uppercase text-brand-gray mb-4">
    Proceso
  </span>
  <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display mb-16">
    Como trabajamos
  </h2>

  {/* Desktop: horizontal layout with connecting line */}
  <div class="hidden md:block relative">
    <div class="absolute top-[2.25rem] left-0 right-0 h-px bg-brand-border" aria-hidden="true"></div>
    <div class="grid grid-cols-5 gap-8 relative" data-animate-stagger>
      {steps.map((step) => (
        <div class="relative">
          <span class="block font-display text-4xl text-brand-blue mb-4">
            {step.number}
          </span>
          <h3 class="font-body text-base font-semibold mb-2">
            {step.title}
          </h3>
          <p class="font-body text-sm text-brand-gray">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>

  {/* Mobile: vertical layout with connecting line on the left */}
  <div class="md:hidden relative pl-10">
    <div class="absolute top-0 bottom-0 left-3 w-px bg-brand-border" aria-hidden="true"></div>
    <div class="flex flex-col gap-10" data-animate-stagger>
      {steps.map((step) => (
        <div class="relative">
          <span class="absolute -left-10 top-0 w-6 h-6 flex items-center justify-center">
            <span class="block w-2 h-2 bg-brand-blue"></span>
          </span>
          <span class="block font-display text-4xl text-brand-blue mb-4">
            {step.number}
          </span>
          <h3 class="font-body text-base font-semibold mb-2">
            {step.title}
          </h3>
          <p class="font-body text-sm text-brand-gray">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
