---
import { getSingleton, getCollection } from '../utils/content';
import { getGoogleReviews } from '../utils/google-reviews';

const home = getSingleton<Record<string, string>>('home');
const site = getSingleton<Record<string, string>>('site');

const testimonialsLabel = home.testimonialsLabel || 'Testimonios';
const testimonialsTitle = home.testimonialsTitle || 'Lo que dicen nuestros clientes';

interface Testimonial {
  clientName: string;
  text: string;
  stars: number;
  source: string;
}

// 1. Try Google Places API first
const { reviews: googleReviews, rating: googleRating } = await getGoogleReviews();

let testimonials: Testimonial[] = [];
let ratingScore = parseFloat(site.googleRating || '5.0');
let ratingTotal = parseInt(site.googleReviewCount || '0', 10);

if (googleReviews.length > 0) {
  testimonials = googleReviews.map((r) => ({
    clientName: r.authorName,
    text: r.text,
    stars: r.rating,
    source: 'google',
  }));
  ratingScore = googleRating.score;
  ratingTotal = googleRating.total;
} else {
  // 2. Fallback to local YAML files via CMS
  const rawTestimonials = getCollection<Testimonial>('testimonials');
  testimonials = rawTestimonials.map((t) => ({
    clientName: String(t.clientName || ''),
    text: String(t.text || ''),
    stars: Number(t.stars ?? 5),
    source: String(t.source || 'google'),
  }));
}

function renderStars(count: number): string {
  return '\u2605'.repeat(count);
}
---

<section id="testimonios" class="py-24" data-animate>
  <div class="px-6 md:px-12 max-w-7xl mx-auto">
    <span class="block font-accent text-xs tracking-wider-label uppercase text-brand-gray mb-4">
      {testimonialsLabel}
    </span>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-16 gap-6">
      <h2 class="font-display text-[clamp(2rem,4vw,3.5rem)] tracking-tight-display">
        {testimonialsTitle}
      </h2>

      {/* Google rating badge */}
      <div class="flex-shrink-0">
        <span class="block font-display text-4xl tracking-tight-display text-brand-dark">
          {ratingScore.toFixed(1)} <span class="text-brand-blue">&#9733;</span>
        </span>
        <span class="block font-accent text-xs tracking-wide-label uppercase text-brand-gray mt-1">
          {ratingTotal > 0 ? `${ratingTotal} reseñas en Google` : 'en Google'}
        </span>
      </div>
    </div>
  </div>

  {/* Horizontal scrollable container */}
  <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 px-6 md:px-12 pb-4 max-w-7xl mx-auto scrollbar-hide">
    {testimonials.map((t) => (
      <div class="min-w-[300px] md:min-w-[400px] flex-shrink-0 p-8 bg-white snap-start">
        <span class="block text-brand-blue text-sm mb-4" aria-label={`${t.stars} estrellas`}>
          {renderStars(t.stars)}
        </span>
        <p class="font-body text-base italic mb-4">
          &ldquo;{t.text}&rdquo;
        </p>
        <span class="block font-accent text-xs tracking-wide-label uppercase text-brand-dark">
          {t.clientName}
        </span>
        <span class="block font-accent text-xs tracking-wide-label uppercase text-brand-gray mt-1">
          Google
        </span>
      </div>
    ))}
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
